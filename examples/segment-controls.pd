#X msg 670 330 type 2 stairs;
#X floatatom 370 375 5 0 1 0 bend_2 - - 0;
#X msg 370 405 bend 2 \$1;
#X obj 370 440 s \$0-editor-in;
#X text 370 65 Segment 1: left of the middle point;
#X text 370 265 Segment 2: right of the middle point;
#X text 20 535 Each type retains its own bend on each segment.;
#X text 20 555 Number boxes send 0..1. Dragging upward increases bend.;
#X text 20 575 These are command inputs. They do not display restored bends.;
#X text 20 595 Point edits renumber segments from left to right.;
#X text 20 615 State restores every type's controls through daw_storage.;
